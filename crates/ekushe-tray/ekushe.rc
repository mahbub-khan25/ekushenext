#include "version.h"

1 ICON "../../assets/icons/ekushe.ico"
1 24 "ekushe.manifest"

1 VERSIONINFO
FILEVERSION     EKUSHE_VERSION_NUM
PRODUCTVERSION  EKUSHE_VERSION_NUM
FILEFLAGSMASK   0x3fL
FILEFLAGS       EKUSHE_VERSION_FLAGS
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Ekushe Next Contributors"
      VALUE "FileDescription",  "Ekushe Next Bangla keyboard"
      VALUE "FileVersion",      EKUSHE_VERSION_STR
      VALUE "InternalName",     "ekushe"
      VALUE "LegalCopyright",   "Ekushe Next Contributors, MPL-2.0"
      VALUE "OriginalFilename", "ekushe.exe"
      VALUE "ProductName",      "Ekushe Next"
      VALUE "ProductVersion",   EKUSHE_VERSION_STR
      VALUE "Comments",         "Open source: https://github.com/mahbub-khan25/ekushenext"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
