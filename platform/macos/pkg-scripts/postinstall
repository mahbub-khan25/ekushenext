#!/bin/bash
# Runs after the installer copies Ekushe.app to /Library/Input Methods.
APP="/Library/Input Methods/Ekushe.app"
# Shishir Bangla, Ekushe's default Bengali font, for every app on this Mac: into /Library/Fonts,
# listed in /Library/Application Support/Ekushe/fonts-installed.txt. A font file that was there
# before and isn't listed is the user's own and stays; a listed one is replaced only by a newer
# version (the font's own version number). Ekushe.app/Contents/Resources/uninstall.sh removes them.
if ! "$APP/Contents/MacOS/Ekushe" --install-fonts; then
  echo "Ekushe: Shishir Bangla could not be added to /Library/Fonts (see the line above); Ekushe itself still uses its own copy." >&2
fi
# Restart a running older copy so the new one loads
/usr/bin/pkill -x Ekushe 2>/dev/null || true
# Add Ekushe to the signed-in user's input sources (they still pick it from the menu bar)
USER_NAME=$(/usr/bin/stat -f%Su /dev/console)
if [ -n "$USER_NAME" ] && [ "$USER_NAME" != "root" ]; then
  USER_ID=$(/usr/bin/id -u "$USER_NAME")
  /bin/launchctl asuser "$USER_ID" /usr/bin/sudo -u "$USER_NAME" "$APP/Contents/MacOS/Ekushe" --register || true
fi
exit 0
